    <string name="settings_about_text">Snakker bilens egen Wi-Fi-protokoll. Bygger på omvendt utvikling fra phev2mqtt (Ben Buxton med flere) og phev-remote (Jamie Nuttall), kontrollert mot den offisielle appen. Ikke tilknyttet Mitsubishi Motors.</string>
    <string name="settings_run_setup">Kjør oppsettet på nytt</string>

    <!-- Setup -->
    <string name="setup_intro">Styr Outlander PHEV via bilens eget Wi-Fi: batteri og lading, klima (varme, kjøling, avising), lys og dører – pluss avreisetidtakere som sjekker været, en widget på startskjermen, en hurtiginnstilling og varsler. Valgfritt via en liten bro (Raspberry Pi) hjemme, så det virker overalt.</string>
    <string name="setup_intro_2">Oppsettet tar noen minutter. Ha bilen i nærheten med nøkkelen, og Wi-Fi-kortet som fulgte med nøklene.</string>
    <string name="setup_start">Kom i gang</string>
    <string name="setup_step1_title">1 · Bilens Wi-Fi</string>
    <string name="setup_pairing_note">Sammenkobling er valgfritt, men anbefalt: uten den spør Android «Koble til enheten?» nå og da, og bakgrunnsfunksjoner (widget, avreiser) kan ikke koble til på egen hånd.</string>
    <string name="setup_bridge_only">Jeg bruker bare bro – hopp over</string>
    <string name="setup_step2_title">2 · Koble til og registrer</string>
    <string name="setup_connect">Koble til</string>
    <string name="setup_status">Status: %1$s</string>
    <string name="setup_car_line">Bil: %1$s · %2$s%%</string>
    <string name="setup_not_registered_title">Ikke registrert ennå?</string>
    <string name="setup_not_registered_explain">Hvis tilkoblingen stopper på «Hilser på bilen» og så feiler, er ikke telefonen registrert i bilen ennå. Telefoner som har brukt den offisielle appen, er som regel allerede registrert.</string>
    <string name="setup_register_phone">Registrer denne telefonen</string>
    <string name="setup_skip_for_now">Hopp over nå</string>
    <string name="setup_step3_title">3 · Alt klart</string>
    <string name="setup_good_to_know">Greit å vite:\n• Trykk lenge på appikonet for snarveier (forvarming, avising, blink med lysene).\n• Legg til widgeten og hurtiginnstillingen «Forvarming».\n• Legg inn de vanlige avreisene dine i fanen Avreiser.\n• Hvert tilkoblingsforsøk logges under Diagnose – del loggen hvis noe oppfører seg rart.\n• For styring fra hvor som helst: sett opp broen (se README) og skriv inn adressen under Innstillinger.</string>
    <string name="setup_open_app">Åpne appen</string>

