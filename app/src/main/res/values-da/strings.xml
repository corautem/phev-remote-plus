    <string name="settings_version">Version</string>
    <string name="settings_about_text">Taler bilens egen Wi-Fi-protokol. Bygger på reverse engineering fra phev2mqtt (Ben Buxton m.fl.) og phev-remote (Jamie Nuttall), krydstjekket mod den officielle app. Ikke tilknyttet Mitsubishi Motors.</string>
    <string name="settings_run_setup">Kør opsætningen igen</string>

    <!-- Setup -->
    <string name="setup_intro">Styr din Outlander PHEV via bilens eget Wi-Fi: batteri og opladning, klima (varme, køling, afisning), lys og døre – plus afgangstimere, der tager højde for vejret, en widget på startskærmen, et felt i kvikindstillingerne og advarsler. Eventuelt via en lille bro (Raspberry Pi) derhjemme, så det virker overalt.</string>
    <string name="setup_intro_2">Opsætningen tager et par minutter. Hav bilen i nærheden med nøglen og Wi-Fi-kortet, der fulgte med nøglerne.</string>
    <string name="setup_start">Kom i gang</string>
    <string name="setup_step1_title">1 · Bilens Wi-Fi</string>
    <string name="setup_pairing_note">Parring er valgfrit, men anbefales: uden den spørger Android »Opret forbindelse til enheden?« nu og da, og baggrundsfunktioner (widget, afgange) kan ikke forbinde af sig selv.</string>
    <string name="setup_bridge_only">Jeg bruger kun en bro – spring over</string>
    <string name="setup_step2_title">2 · Forbind og registrer</string>
    <string name="setup_connect">Forbind</string>
    <string name="setup_status">Status: %1$s</string>
    <string name="setup_car_line">Bil: %1$s · %2$s%%</string>
    <string name="setup_not_registered_title">Ikke registreret endnu?</string>
    <string name="setup_not_registered_explain">Hvis forbindelsen stopper ved »Hilser på bilen« og derefter fejler, er telefonen ikke registreret i bilen endnu. Telefoner, der har brugt den officielle app, er som regel allerede registreret.</string>
    <string name="setup_register_phone">Registrer denne telefon</string>
    <string name="setup_skip_for_now">Spring over indtil videre</string>
    <string name="setup_step3_title">3 · Alt er klar</string>
    <string name="setup_good_to_know">Godt at vide:\n• Tryk længe på appikonet for genveje (forvarmning, afisning, blink med lygterne).\n• Tilføj widgetten og feltet »Forvarmning« i kvikindstillingerne.\n• Planlæg dine faste afgange under fanen Afgange.\n• Alle forbindelsesforsøg logges under Diagnose – del loggen, hvis noget driller.\n• Til styring hvor som helst: opsæt broen (se README), og indtast dens adresse under Indstillinger.</string>
    <string name="setup_open_app">Åbn appen</string>

