[Unit]
Description=PHEV Link bridge (Outlander PHEV Wi-Fi remote)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phev
ExecStart=/usr/bin/java -Xmx64m -Dstdout.encoding=UTF-8 -jar /opt/phev-bridge/phev-bridge.jar /etc/phev-bridge.properties
Restart=always
RestartSec=5
StateDirectory=phev-bridge
LogsDirectory=phev-bridge

[Install]
WantedBy=multi-user.target
