    <!-- Setup -->
    <string name="setup_intro">Control your Outlander PHEV over its own Wi-Fi: battery and charging, climate (heat, cool, defrost), lights, doors — plus departure timers that read the weather, a home-screen widget, a quick-settings tile, and alerts. Best with a small bridge at home that stays in touch with the car, so it works from anywhere.</string>
    <string name="setup_intro_2">Setup takes a few minutes. Have the car nearby with its key, and the Wi-Fi card that came with the keys.</string>
    <string name="setup_start">Start</string>
    <string name="setup_step1_title">1 · The car\'s Wi-Fi</string>
    <string name="setup_pairing_note">Pairing is optional but recommended: without it Android asks \"Connect to device?\" now and then, and background features (widget, departures) can\'t connect on their own.</string>
    <string name="setup_bridge_only">I\'ll only use a bridge — skip</string>
    <string name="setup_step2_title">2 · Connect and register</string>
    <string name="setup_connect">Connect</string>
    <string name="setup_status">Status: %1$s</string>
    <string name="setup_car_line">Car: %1$s · %2$s%%</string>
    <string name="setup_not_registered_title">Not registered yet?</string>
    <string name="setup_not_registered_explain">If the connection stops at \"Saying hello\" and then fails, this phone isn\'t registered with the car yet. Phones that used the official app are usually already registered.</string>
    <string name="setup_register_phone">Register this phone</string>
    <string name="setup_skip_for_now">Skip for now</string>
    <string name="setup_step3_title">3 · All set</string>
    <string name="setup_good_to_know">Good to know:\n• Long-press the app icon for shortcuts (preheat, defrost, flash lights).\n• Add the widget and the \"Preheat\" quick-settings tile.\n• Schedule your usual departures in the Schedule tab.\n• Questions? Settings → Help &amp; FAQ.\n• Every connection attempt is logged under Settings → Diagnostics — share the log if something misbehaves.\n• For control from anywhere, set up a bridge under Settings → Bridge.</string>
    <string name="setup_open_app">Open the app</string>

